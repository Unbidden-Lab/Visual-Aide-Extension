{
  "manifest_version": 3,
  "name": "Visual Aide",
  "version": "1.3.0",
  "description": "Dynamic, client-side typographic and sensory interventions for dyslexia and visual reading accessibility with offline PDF reader.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dictionary.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*",
        "lib/*",
        "dictionary.js",
        "reader.html",
        "reader.js",
        "reader.css"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "toggle-active": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "Toggle Visual Aide on/off"
    }
  }
}